@model IEnumerable<Book>

<!-- Hero Section -->
<div class="container-fluid bg-gradient py-4 mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="row">
        <div class="col-12 text-center text-primary">
            <h1 class="display-5 fw-bold mb-2">Welcome to BooksMart</h1>
            <p class="lead mb-0">Discover your next favorite book from our curated collection</p>
        </div>
    </div>
</div>

<!-- Books Grid -->
<div class="container">
    <div class="row pb-3 g-4">
        @foreach (var book in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card h-100 shadow-lg border-0 rounded-3 overflow-hidden transition-transform"
                     style="transition: transform 0.3s ease, box-shadow 0.3s ease;"
                     onmouseover="this.style.transform='translateY(-10px)'; this.style.boxShadow='0 1rem 3rem rgba(0,0,0,0.25)';"
                     onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 0.5rem 1rem rgba(0,0,0,0.15)';">

                    <!-- Image Container with Overlay -->
                    <div class="position-relative overflow-hidden" style="height: 300px;">
                        @if(book.BookImages!=null && book.BookImages.Count() > 0)
                        {
                            <img src="@book.BookImages.FirstOrDefault().ImageUrl" class="card-img-top h-100 w-100" style="object-fit: contain; background-color: #f8f9fa;" alt="@book.Title">
                        }
                        else
                        {
                            <img src="https://placehold.co/500x600/png" class="card-img-top rounded" />
                        }
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge bg-danger bg-gradient px-3 py-2 shadow">
                                <i class="bi bi-fire"></i> HOT
                            </span>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="card-title text-dark fw-bold text-center mb-2" style="min-height: 50px; line-height: 1.3;">
                            @book.Title
                        </h5>
                        <p class="text-muted text-center mb-3 fst-italic">
                            <i class="bi bi-pen"></i> by <span class="text-primary fw-semibold">@book.AuthorName</span>
                        </p>

                        <!-- Divider -->
                        <hr class="my-3">

                        <!-- Pricing Section -->
                        <div class="text-center mb-3">
                            <div class="mb-2">
                                <small class="text-muted">List Price:</small>
                                <span class="text-decoration-line-through text-muted d-block fs-6">
                                    @book.ListPrice.ToString("c")
                                </span>
                            </div>
                            <div class="bg-light rounded p-2 mb-2">
                                <small class="text-success fw-semibold d-block mb-1">
                                    <i class="bi bi-tag-fill"></i> Best Price
                                </small>
                                <span class="text-primary fw-bold fs-4">
                                    @book.Price100.ToString("c")
                                </span>
                                <small class="text-muted d-block">(for 100+ qty)</small>
                            </div>
                            <div class="d-flex justify-content-between align-items-center px-2">
                                <small class="text-muted">
                                    <i class="bi bi-lightning-charge-fill text-warning"></i> Save up to
                                    <span class="fw-bold text-success">
                                        @{
                                            var savings = ((book.ListPrice - book.Price100) / book.ListPrice * 100);
                                        }
                                        @savings.ToString("0")%
                                    </span>
                                </small>
                            </div>
                        </div>

                        <!-- Action Button -->
                        <div class="mt-auto">
                            <a asp-action="Details"
                               asp-route-id="@book.Id"
                               class="btn btn-primary bg-gradient border-0 w-100 py-2 fw-semibold position-relative overflow-hidden"
                               style="transition: all 0.3s ease;">
                                <i class="bi bi-book"></i> View Details
                                <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Add custom CSS for hover effects -->
<style>
    .card:hover .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        transform: scale(1.02);
    }

    .card img {
        transition: transform 0.3s ease;
    }

    .card:hover img {
        transform: scale(1.05);
    }
</style>