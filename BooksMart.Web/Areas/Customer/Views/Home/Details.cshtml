@model Book
<form method="post">
    <!-- Back Button -->
    <div class="container mt-3">
        <a asp-action="Index" class="btn btn-outline-primary bg-gradient fw-semibold">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
    </div>

    <!-- Main Content Card -->
    <div class="container my-4">
        <div class="card shadow-lg border-0 rounded-3 overflow-hidden">
            <!-- Header with Gradient -->
            <div class="card-header text-white py-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="text-center">
                    <h2 class="fw-bold mb-2">@Model.Title</h2>
                    <p class="mb-0 fs-5">
                        <i class="bi bi-pen"></i> by <span class="fw-semibold">@Model.AuthorName</span>
                    </p>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-4">
                    <!-- Left Column - Book Image -->
                    <div class="col-lg-4">
                        <div class="position-relative">
                            <img src="@Model.ImageUrl" class="img-fluid rounded-3 shadow-sm w-100" alt="@Model.Title" style="object-fit: contain; background-color: #f8f9fa; max-height: 500px;" />
                            <div class="position-absolute top-0 start-0 m-3">
                                <span class="badge bg-primary bg-gradient px-3 py-2 fs-6">
                                    @Model.Category.Name
                                </span>
                            </div>
                        </div>

                        <!-- ISBN Badge -->
                        <div class="mt-3 p-3 bg-light rounded-3 text-center">
                            <small class="text-muted d-block mb-1">ISBN</small>
                            <span class="fw-bold text-dark">@Model.ISBN</span>
                        </div>
                    </div>

                    <!-- Right Column - Book Details -->
                    <div class="col-lg-8">
                        <!-- Price Section -->
                        <div class="mb-4">
                            <div class="d-flex align-items-center mb-3">
                                <h5 class="text-muted mb-0 me-3">List Price:</h5>
                                <h4 class="text-decoration-line-through text-muted mb-0">
                                    @Model.ListPrice.ToString("c")
                                </h4>
                            </div>

                            <!-- Pricing Table -->
                            <div class="card border-0 shadow-sm">
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="py-3 ps-4">
                                                        <i class="bi bi-cart-check"></i> Quantity
                                                    </th>
                                                    <th class="py-3 text-center">1-50</th>
                                                    <th class="py-3 text-center">51-100</th>
                                                    <th class="py-3 text-center">100+</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td class="py-3 ps-4 fw-bold text-primary">
                                                        <i class="bi bi-tag-fill"></i> Price
                                                    </td>
                                                    <td class="py-3 text-center fw-bold text-success fs-5">
                                                        @Model.Price.ToString("c")
                                                    </td>
                                                    <td class="py-3 text-center fw-bold text-success fs-5">
                                                        @Model.Price50.ToString("c")
                                                    </td>
                                                    <td class="py-3 text-center fw-bold text-success fs-5">
                                                        @Model.Price100.ToString("c")
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Savings Badge -->
                            <div class="alert alert-success mt-3 mb-0" role="alert">
                                <i class="bi bi-lightning-charge-fill"></i>
                                <strong>
                                    Save up to @{
                                    var savings = ((Model.ListPrice - Model.Price100) / Model.ListPrice * 100);
                                                                        }
@savings.ToString("0")%
                                </strong> when you buy in bulk!
                            </div>
                        </div>

                        <!-- Description Section -->
                        <div class="mb-4">
                            <h5 class="fw-bold mb-3">
                                <i class="bi bi-book"></i> Description
                            </h5>
                            <div class="p-3 bg-light rounded-3">
                                <p class="text-secondary mb-0 lh-base">@Model.Description</p>
                            </div>
                        </div>

                        <!-- Order Section -->
                        <div class="card border-primary border-2 shadow-sm">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-3">
                                    <i class="bi bi-cart-plus"></i> Order Now
                                </h5>
                                <div class="row align-items-end g-3">
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Quantity</label>
                                        <div class="input-group input-group-lg">
                                            <span class="input-group-text bg-primary text-white border-0">
                                                <i class="bi bi-hash"></i>
                                            </span>
                                            <input type="number" value="1" min="1" class="form-control form-control-lg text-center fw-bold"
                                                   aria-label="Quantity" />
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <button type="button" disabled
                                                class="btn btn-secondary btn-lg w-100 py-3 fw-semibold"
                                                style="cursor: not-allowed;">
                                            <i class="bi bi-cart-plus-fill me-2"></i>
                                            Add to Cart (Coming Soon...)
                                        </button>
                                    </div>
                                </div>

                                <!-- Features -->
                                <div class="row mt-4 g-3">
                                    <div class="col-md-4">
                                        <div class="text-center p-2">
                                            <i class="bi bi-truck fs-3 text-primary"></i>
                                            <p class="mb-0 mt-2 small fw-semibold">Free Shipping</p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="text-center p-2">
                                            <i class="bi bi-shield-check fs-3 text-success"></i>
                                            <p class="mb-0 mt-2 small fw-semibold">Secure Payment</p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="text-center p-2">
                                            <i class="bi bi-arrow-repeat fs-3 text-info"></i>
                                            <p class="mb-0 mt-2 small fw-semibold">Easy Returns</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(102, 126, 234, 0.1);
    }

    .btn-primary:disabled {
        opacity: 0.7;
    }
</style>