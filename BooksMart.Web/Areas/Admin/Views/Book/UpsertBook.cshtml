@model BookVM


<div class="container my-4">

    <h2 class="mb-4 text-center">@(Model.Book.Id!=0?"Update":"Create") Book</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="UpsertBook" method="post" enctype="multipart/form-data">
                <input asp-for="Book.Id" hidden/>
                <div class="row">
                    <div class="col-10">
                        <div class="mb-3">
                            <label asp-for="Book.Title" class="form-label"></label>
                            <input asp-for="Book.Title" class="form-control" placeholder="Enter book title" />
                            <span asp-validation-for="Book.Title" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Book.Description" class="form-label"></label>
                            <textarea asp-for="Book.Description" class="form-control"
                                      style="height:220px; width:100%; resize:vertical;"
                                      placeholder="Enter book description"></textarea>
                            <span asp-validation-for="Book.Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Book.AuthorName" class="form-label"></label>
                            <input asp-for="Book.AuthorName" class="form-control" placeholder="Enter author name" />
                            <span asp-validation-for="Book.AuthorName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Book.ISBN" class="form-label"></label>
                            <input asp-for="Book.ISBN" class="form-control" placeholder="Enter ISBN" />
                            <span asp-validation-for="Book.ISBN" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Book.ListPrice" class="form-label"></label>
                                <input asp-for="Book.ListPrice" class="form-control" placeholder="Enter list price" />
                                <span asp-validation-for="Book.ListPrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Book.Price" class="form-label"></label>
                                <input asp-for="Book.Price" class="form-control" placeholder="Price for 1–50" />
                                <span asp-validation-for="Book.Price" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Book.Price50" class="form-label"></label>
                                <input asp-for="Book.Price50" class="form-control" placeholder="Price for 50+" />
                                <span asp-validation-for="Book.Price50" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Book.Price100" class="form-label"></label>
                                <input asp-for="Book.Price100" class="form-control" placeholder="Price for 100+" />
                                <span asp-validation-for="Book.Price100" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Book.CategoryId" class="form-label"></label>
                                <select asp-for="Book.CategoryId" asp-items="@Model.CategoryList" class="form-select border-0 shadow">
                                    <option disabled selected>-- Select Category --</option>
                                </select>
                                <span asp-validation-for="Book.CategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Book.BookImages" class="form-label"></label>
                                <input type="file" name="files" class="form-control" multiple />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                @if (Model.Book.Id != 0)
                                {
                                    <button type="submit" class="btn btn-primary form-control">
                                        Update
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-primary form-control">
                                        Create
                                    </button>
                                }

                            </div>
                            <div class="col-6">
                                <a asp-action="Index" class="btn btn-outline-secondary border ms-2 form-control">
                                    Back to List
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-2">
                            @if (Model.Book.BookImages != null)
                            {
                                @foreach(var img in Model.Book.BookImages)
                                {
                                    <div class="border p-1 m-2 text-center">
                                    <img src="@img.ImageUrl" width="100%"
                                         style="border-radius=: 5px; border:1px solid #bbb9b9" />
                                         <a asp-action="DeleteImage" class="btn btn-danger" asp-route-imgId="@img.Id">
                                             <i class="bi bi-trash-fill"></i>Delete
                                         </a>
                                    </div>
                                }
                            }
                    </div>
                </div>
                


            </form>

        </div>
    </div>

</div>

@* client-side validation *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}