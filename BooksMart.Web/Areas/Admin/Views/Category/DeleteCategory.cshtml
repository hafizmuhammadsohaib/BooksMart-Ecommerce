@model Category

<div class="container mt-4">

    <h2 class="mb-4 text-center">Delete Category</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="DeleteCategory" method="post">

                <input asp-for="Id" type="hidden" />
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" disabled />
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayOrder" class="form-label"></label>
                    <input asp-for="DisplayOrder" class="form-control" disabled />
                </div>
                <div class="row">
                    <div class="col-6">
                        <button type="submit" class="btn btn-danger form-control">
                            Delete
                        </button>
                    </div>
                    <div class="col-6">
                        <a asp-action="Index" class="btn btn-outline-secondary border ms-2 form-control">
                            Back to List
                        </a>
                    </div>
                </div>


            </form>

        </div>
    </div>

</div>