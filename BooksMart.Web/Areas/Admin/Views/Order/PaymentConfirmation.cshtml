@model int

<div class="container row pt-4">
    <div class="col-12 text-center">
        <h1 class="text-primary text-center">Payment Successful!</h1>
        <h4>Your order number is: <strong>@Model</strong></h4><br /><br />
        <img src="~/images/OrderConfirmed.png" width="70%" />
    </div>
    <div class="col-12 text-center" style="color:maroon">
        <br />
        Your Payment has been Applied Successfully! <br />
        <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@Model" class="btn btn-primary">Back to Orders Details</a>
    </div>
</div>