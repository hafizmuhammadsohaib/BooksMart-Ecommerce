<div class="container">
    <div class="row pt-4 pb-3">
        <div class="col-6">
            <h2 class="text-primary">
                Companies List
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Company" asp-action="UpsertCompany" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Create
            </a>
        </div>
    </div>
    <table id="tblData" class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>City</th>
                <th>Province</th>
                <th>Postal Code</th>
                <th>Phone Number</th>
            </tr>
        </thead>
    </table>
</div>
@section Scripts{
    <script src="~/js/Company.js"></script>
}